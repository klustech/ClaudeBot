# ---- Copy to .env. NEVER commit .env. Claude Code is denied read access to .env. ----

# Model / research MCP credentials (used by Claude Code, not by the trading backend)
ANTHROPIC_API_KEY=
TRADER_DEV_KEY=

# Exchange (backend only; never shown to Claude). Use a dedicated sub-account with withdrawals disabled.
EXCHANGE=paper                 # paper | bybit | browser-bridge
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_READ_ONLY=true        # READ_ONLY first, then TESTNET, then tiny LIVE

# Storage. Without DATABASE_URL an embedded PGlite database is used (single process, dev only).
DATABASE_URL=postgres://trader:trader@127.0.0.1:5432/claude_trader
REDIS_URL=redis://127.0.0.1:6379

# Safety switches — defaults are the safe values.
TRADING_MODE=paper             # research | backtest | validation | paper | testnet | live
TRADING_ENABLED=false          # executor places NO trades unless true
LIVE_TRADING_ENABLED=false     # LIVE is impossible unless true (human decision)

# Services
API_HOST=127.0.0.1
API_PORT=4100
API_URL=http://127.0.0.1:4100
EXECUTOR_URL=http://127.0.0.1:4200
EXECUTOR_PORT=4200
EXECUTOR_TOKEN=                # shared secret API ↔ executor (openssl rand -hex 32)
CONTROL_API_TOKEN=             # token used by the trading-control MCP (Claude-level access)
HUMAN_API_TOKEN=               # human operator token (approve, go live, reset breakers)
BRIDGE_SIGNING_SECRET=         # ≥32 chars, only for the browser-extension bridge

# Paper trading
PAPER_STARTING_BALANCE=1000
CURRENCY=GBP
PAPER_FEED=binance             # binance (live public stream) | replay (dataset FORWARD period)
INSTRUMENT=linear-perp         # key in config/instruments.json

# Research
RESEARCH_STAKE=10
RESEARCH_CAPITAL=1000
RESEARCH_SEED=42
RESEARCH_MAX_CONFIGS=120

# Alerts (generic JSON webhook: Slack/Discord relay, ntfy, etc.)
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
